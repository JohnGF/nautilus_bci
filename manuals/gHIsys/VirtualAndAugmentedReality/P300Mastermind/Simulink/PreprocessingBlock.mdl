    Block {
      BlockType		      SubSystem
      Name		      "Preprocess"
      SID		      "37"
      Ports		      [3, 5]
      Position		      [95, 69, 165, 151]
      ZOrder		      208
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		89
	$ClassName		"Simulink.Mask"
	Type			"Preprocessing"
	Description		"Applys all necessary preprocessing stepts to the in comming raw data\nThis includes downsampling to 64 "
	"Hz, checking the quality and reliability of the signals and applying any necessary filtering step"
	Initialization		"hh = get(0,'ShowHiddenHandles');    \ntry\n    close_system([[bdroot(gcb),'/Preprocess'],'/g.SQcheck"
	"'])\n    set(0,'ShowHiddenHandles','on');\n    sqck = findobj('name','Online Signal Quality Check');    \n    set(0,'"
	"ShowHiddenHandles',hh);\n    close(sqck);\ncatch\n    set(0,'ShowHiddenHandles',hh);\nend\ntry\n    close_system([[bd"
	"root(gcb),'/Preprocess'],'/Bandpass Butterworth Filter'])\ncatch\nend\n\nset_param([[bdroot(gcb),'/Preprocess'],'/Num"
	" invalid channels'],'const',numinvalid)\nset_param([[bdroot(gcb),'/Preprocess'],'/Downsample'],'N',samplingfactor)\ni"
	"f length(batterylevels) < 2 || batterylevels(2) >= 100 || batterylevels(2) <= 0\n    batterylevels(2) = 5;\nend\nif b"
	"atterylevels(1) < batterylevels(2) \n    batterylevels(1) = batterylevels(2);\nend\nif length(linkquality) < 2 || lin"
	"kquality(2) >= 100 || linkquality(2) <= 0 \n    linkquality(2) = 10;\nend\nif linkquality(1) < linkquality(2)\n    li"
	"nkquality(1) = linkquality(2);\nend\nset_param([[bdroot(gcb),'/Preprocess'],'/Off Lim'],'const',sprintf('[%.1f,%.1f]'"
	",linkquality(2),batterylevels(2)));\nset_param([[bdroot(gcb),'/Preprocess'],'/Warn Lim'],'const',sprintf('[%.1f,%.1f]"
	"',linkquality(1),batterylevels(1)));\n\n"
	SelfModifiable		"on"
	Display			"port_label('Input',1,'Raw EEG')\nport_label('Input',2,'LQI')\nport_label('Input',3,'Batt')\nport_label('Ou"
	"tput',1,'SQ')\nport_label('Output',2,'Health')\n\ntry\n    sfreq = 1/str2num(get(get_param(bdroot(gcb),'Handle'),'Fix"
	"edStep'));\n    if ~exist('sfreq','var') || size(sfreq,1) ~= 1 || size(sfreq,2) ~= 1 || length(size(sfreq))>2\n      "
	"  sreq = 256;\n    end\ncatch ME\n    sfreq = 256;\n    \nend\nds = sfreq/str2num(get_param(gcb,'samplingfactor'));\n"
	"port_label('Output',3,sprintf('%.0f Hz',sfreq));\nport_label('Output',4,sprintf('%.1f Hz',ds));\nport_label('Output',"
	"5,'Signal bad');\n"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  6
	  Object {
	    $ObjectID		    90
	    Type		    "checkbox"
	    Name		    "adjustsignalquality"
	    Prompt		    "Adjust signal quality settings"
	    Value		    "off"
	    Evaluate		    "off"
	    Tunable		    "off"
	    Callback		    "openSQcheck"
	  }
	  Object {
	    $ObjectID		    91
