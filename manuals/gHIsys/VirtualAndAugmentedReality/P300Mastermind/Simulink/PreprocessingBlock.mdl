    Block {
      BlockType		      SubSystem
      Name		      "Display controller"
      SID		      "112"
      Ports		      [5, 7]
      Position		      [480, 58, 635, 192]
      ZOrder		      210
      ForegroundColor	      "green"
      BackgroundColor	      "darkGreen"
      DeleteFcn		      "debug_Display_controller(true);"
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		20
	$ClassName		"Simulink.Mask"
	Type			"Display controller"
	Description		"Controls the output to the primary user interface based upon the\nprovided input patterns, the feedback"
	" information and the XML file\ndescribing the symbols to be displayed and their order."
	Help			"Controls the output to the primary user interface based upon the\nprovided input patterns, the feedback infor"
	"mation and the XML file\ndescribing the symbols to be displayed and their order.\n\nThe following parameters can be u"
	"sed to define the style of the output and\non which system it should be displayed.\n\n\n<b>Cursor style:</b> defines "
	"the style of the cursor used to step through\nthe individual symbols. The following values are avialable\n    <i>Inve"
	"rting</i> ...... inverts the colors of the symbols\n    <i>Faces</i> .......... display images of well known people\n"
	"\n<b>XML storage path</b> the pather where the mask description and all other\nmedia are located. Must be equal to th"
	"e path specified for the Interface unit\n\n<b>XML mask file name</b> the name of the file describing the symbols to \n"
	"be displayed.\n\n<b>Display IP</b> the ip address of the computer connected to the user \ndisplay\n\n<b>Display port<"
	"/b> the port the display is receiving messages from the \ncontroller.\n\n<b>Controller port</b> the port the controll"
	"er is receiving response messages\nfrom the display\n\n<b>Auto start dispaly (localhot only)</b> if set than the disp"
	"lay application\nis started if necessary. It will not be started wither whien this controll is\noff or when <b>Displa"
	"y IP</b> is not set to localhost (127.0.0.1)\n\n"
	Initialization		"debug_Display_controller;"
	SelfModifiable		"on"
	Display			"image(imread('soci.jpg'))\n\nport_label('output', 1, 'Flashed')\nport_label('output', 2, 'Dim')\nport_labe"
	"l('output', 3, 'Mouse Cue')\nport_label('output', 4, 'FB visible')\nport_label('output', 5, 'Updated')\nport_label('o"
	"utput', 7, 'Hold')\nport_label('output', 6, 'Selected ID')\nport_label('input', 1, 'Pattern')\nport_label('input', 2,"
	" 'Result ID')\nport_label('input', 3, 'Cue')\nport_label('input', 4, 'Disable')\nport_label('input', 5, 'Update')"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  13
	  Object {
	    $ObjectID		    21
	    Type		    "popup"
	    Array {
	      Type		      "Cell"
	      Dimension		      2
	      Cell		      "Inverting"
	      Cell		      "Faces"
