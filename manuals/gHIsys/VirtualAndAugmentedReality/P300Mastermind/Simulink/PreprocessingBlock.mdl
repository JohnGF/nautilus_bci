	    Value		    "off"
	    Evaluate		    "off"
	    Tunable		    "off"
	    Callback		    "openFilterSettings"
	  }
	  Object {
	    $ObjectID		    92
	    Type		    "edit"
	    Name		    "numinvalid"
	    Prompt		    "Stop if more than # channels are invalid"
	    Value		    "8"
	    Evaluate		    "off"
	  }
	  Object {
	    $ObjectID		    93
	    Type		    "edit"
	    Name		    "batterylevels"
	    Prompt		    "Batterly levels [%] (Warn, Off)"
	    Value		    "[30,5]"
	  }
	  Object {
	    $ObjectID		    94
	    Type		    "edit"
	    Name		    "linkquality"
	    Prompt		    "Link Quality [%] ( Warn, Lost)"
	    Value		    "[ 50 6]"
	  }
	  Object {
	    $ObjectID		    95
	    Type		    "edit"
	    Name		    "samplingfactor"
	    Prompt		    "Sampling factor"
	    Value		    "4"
	    Evaluate		    "off"
	    Tunable		    "off"
	  }
	  PropName		  "Parameters"
	}
