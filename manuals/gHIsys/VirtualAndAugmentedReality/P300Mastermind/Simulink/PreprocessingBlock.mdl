    Block {
      BlockType		      SubSystem
      Name		      "Signal Processing"
      SID		      "164"
      Ports		      [5, 3]
      Position		      [75, 191, 185, 269]
      ZOrder		      278
      NameLocation	      "top"
      AncestorBlock	      "PreprocessingBlock/Signal Processing"
      LibraryVersion	      "*1.18.00"
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		105
	$ClassName		"Simulink.Mask"
	Type			"P300 Signal Processing"
	Description		"The block buffers EEG data for each ID-Flash obtained. As soon as M \n(Number of flashes) characters of"
	" each ID are obtained, or a decision may \nbe taken on the symbol selected by the user when one of the statistical \n"
	"evaluation methods  is selceted, a STOP command is sent and the maximum \nP300 is calculated and applied on output ID"
	"."
	Help			"P300 Signal Processing block. The block buffers EEG data for each ID-Flash \nobtained. As soon as M (Number o"
	"f flashes) characters of each ID are \nobtained, or a decision may be taken on the symbol selected by the user \nwhen"
	" one of the statistical approaches is selceted, a STOP command is sent \nand the maximum P300 is calculated and appli"
	"ed on output ID.<br>\n\n<b>Buffer length [ms]</b> - enter the EEG data buffer size <br><br>\n\n<b>Number of flashes</"
	"b> - enter the number each character should flash up <br><br>\n\n<b>Classification method</b> - names the method used"
	" for classifying the data \n                           corresponding to each individual flash pattern. \n            "
	"               The used method is defined by the classifier loaed\n                           For example the followi"
	"ng are supported<br>\n   LDA ... Linear discriminant analysis (default) <br>\n   SVM ... Support vector machines <br>"
	"<br>\n\n<b>Evaluation method</b> - Approach used to identify the symbol selected by \n                           the "
	"users <br>\n    <i>Fixed number of flashes</i>\n        No output will be generated before not all symbols/rows/colum"
	"ns have \n        flashed at leased <b>Number of flashes times</b><br>\n \n    <i>Global P statistics</i>\n        Af"
	"ter each flash cycle the global scores for each symbol are updated.\n        If the residual error of at least one sy"
	"mbol drops below the value \n        specified for the <b>Global residual error probability</b> parameter,\n        t"
	"he flashing stops and the ID is set to the corresponding symbol \n        identifier<br>\n\n   <i>Fixed number of fla"
	"shes with global P-statistics</i>\n        A combination of the <i>Fixed number of flasehs</i> and the\n        <i>Gl"
	"obal P-statistics</i> modes.\n   \n<b>Global residual error probability [%]</b> - The residual error probability\n   "
	" limit which is used by the <i>Global p statistics</i> and the \n    <i>Per run P statistics</i> mode to determine wh"
	"ether a decision about \n    the chosen symbol may be taken or not.\n\n    <i>NOTE:</i> if set to empty value than th"
	"e following polynome will be \n                 used to compute an appropriate value<br><br>\n    <center> ci = -0.00"
	"2748869222306 * nfl^3  + 0.102514650781359 * nfl^2 -1.290670937088071 * nfl + 5.858716739649105</center>\n\n<b>Clasif"
	"ier file</b> - The name of a valid P300classifier file. "
	Initialization		"try\nclobj = {};\ntry\n    classifierhandle = matfile(classifierfile);\n    classifierhandle = class"
	"ifierhandle.P300Classifier;\n    totalclasses = classifierhandle.numClasses;\n    if totalclasses < 2\n        totalc"
	"lasses = 2;\n    end\n    set_param(gcb,'method',classifierhandle.methodName);\ncatch mee\n    disp(getReport(mee))\n"
	"    disp('safe')\n    totalclasses = 2;\nend\nif ~isempty(clobj)\n    clear(clobj{:});\nend\ncatch me\n    disp(getRe"
	"port(me));\n    disp('bad')\nend"
	SelfModifiable		"on"
	Display			"image(imread('p300.png'))\nport_label('output', 1, 'STOP')\nport_label('output', 2, 'ID')\nport_label('out"
	"put', 3, 'History')\nport_label('input', 4, 'EEG')\nport_label('input', 3, 'DIM')\nport_label('input', 1, 'EOT')\npor"
	"t_label('input', 2, 'Pattern')\nport_label('input', 5, 'Reload')"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  7
	  Object {
	    $ObjectID		    106
	    Type		    "edit"
	    Name		    "windTime"
	    Prompt		    "Buffer length [ms]"
	    Value		    "800"
	    Tunable		    "off"
	  }
	  Object {
	    $ObjectID		    107
	    Type		    "edit"
	    Name		    "runmax"
	    Prompt		    "Number of flashes:"
	    Value		    "15"
	    Tunable		    "off"
	  }
	  Object {
	    $ObjectID		    108
	    Type		    "edit"
	    Name		    "method"
	    Prompt		    "Classification method:"
	    Value		    "Linear Discriminant Analysis"
	    Evaluate		    "off"
	    Tunable		    "off"
	    Enabled		    "off"
	  }
	  Object {
	    $ObjectID		    109
	    Type		    "popup"
	    Array {
	      Type		      "Cell"
	      Dimension		      3
	      Cell		      "Fixed number of flashes"
	      Cell		      "Global P statistics"
	      Cell		      "Fixed number of flashes with global P-statistics"
	      PropName		      "TypeOptions"
	    }
	    Name		    "evaluationmethod"
	    Prompt		    "Evaluation method:"
	    Value		    "Fixed number of flashes"
	    Tunable		    "off"
	  }
	  Object {
	    $ObjectID		    110
	    Type		    "edit"
	    Name		    "canselect"
	    Prompt		    "Global residual error probability [%]"
	    Value		    "0.35"
	    Tunable		    "off"
	  }
	  Object {
	    $ObjectID		    111
	    Type		    "edit"
	    Name		    "classifierfile"
	    Prompt		    "Clasifier file"
	    Value		    "Subject_1_training_31_03_2021_08_35_44_0000_LDA.mat"
	    Evaluate		    "off"
	    Tunable		    "off"
	  }
	  Object {
	    $ObjectID		    112
	    Type		    "edit"
	    Name		    "sharedwith"
	    Prompt		    "Shared With"
	    Value		    "1"
	    Evaluate		    "off"
	    Tunable		    "off"
	    Enabled		    "off"
	    Visible		    "off"
	  }
	  PropName		  "Parameters"
	}
      }
