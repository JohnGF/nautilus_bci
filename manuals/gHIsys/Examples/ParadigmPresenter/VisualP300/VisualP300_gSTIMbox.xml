        <Task ns:type="SingleTask" ID="ST_Dark" DurationSeconds="0.2">
        </Task>
        <Task ns:type="MultiTask" ID="MT_Stim" TaskOrder="RandomWithoutReplacement" SampleSize="1">
          <Task ns:type="SingleTask" ID="ST_NT1" DurationSeconds="0.2" Group="1">
