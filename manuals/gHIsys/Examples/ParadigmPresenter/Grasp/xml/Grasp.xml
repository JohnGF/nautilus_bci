<?xml version="1.0" encoding="utf-8"?>
<Data  xmlns="xsd"
           xmlns:ns="http://www.w3.org/2001/XMLSchema-instance"
           ns:schemaLocation="xsd ../../ParadigmSchema.xsd">

  <Paradigm BaseFolder="media/" TaskOrder="Deterministic">
    <Task ns:type="SingleTask" ID="ST_PreParadigm" DurationSeconds="10">
      <Stimulus ns:type="TextStimulus" Caption="+"/>
    </Task>
	  <Task ns:type="MultiTask" ID="MT_TaskSequence" TaskOrder="Deterministic" SampleSize="30">
		  <Task ns:type="MultiTask" ID="MT_Move" TaskOrder="RandomWithoutReplacement" SampleSize="1">
			  <Task ns:type="SingleTask" ID="ST_REST" DurationSeconds="15" Group="2">
				<Stimulus ns:type="PictureStimulus" FileName="rest.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
		  </Task>
		  <Task ns:type="MultiTask" ID="MT_Distract" TaskOrder="RandomWithoutReplacement" SampleSize="1">
			  <Task ns:type="SingleTask" ID="ST_GRASP" DurationSeconds="10" Group="1">
			    <Stimulus ns:type="PictureStimulus" FileName="grasp.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
		  </Task>
	  </Task>
    <Task ns:type="SingleTask" ID="ST_PostParadigm" DurationSeconds="50"  Group="3">
      <Stimulus ns:type="TextStimulus" Caption="Thank You!"/>
    </Task>
  </Paradigm>

</Data>