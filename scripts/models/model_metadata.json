  },
  "evidence_accumulation": {
    "window_size_s": 2.0,
    "step_size_s": 0.5,
    "default_confidence_threshold": 0.8,
    "max_accumulation_steps": 3
  },
  "hardware_montage": "dry_electrodes_32ch"
}