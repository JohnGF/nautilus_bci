{
  "model_family": "EEGNet-8,2 & Hierarchical Riemannian",
  "channels": 32,
  "sampling_rate_hz": 250.0,
  "epoch_duration_s": 3.0,
  "epoch_samples": 750,
  "classes": {
    "0": "FIRE (Kiss / Energy)",
    "1": "WATER (It's Raining Men / Nature)",
    "2": "WIND (What's Up / Nature)",
    "3": "ELECTRICITY (Thunderstruck / Energy)"
