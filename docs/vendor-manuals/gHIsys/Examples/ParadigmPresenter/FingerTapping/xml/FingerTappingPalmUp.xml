<?xml version="1.0" encoding="utf-8"?>
<Data  xmlns="xsd"
           xmlns:ns="http://www.w3.org/2001/XMLSchema-instance"
           ns:schemaLocation="xsd ../../ParadigmSchema.xsd">

  <Paradigm BaseFolder="media/palmUp/" TaskOrder="Deterministic">
    <Task ns:type="SingleTask" ID="ST_PreParadigm" DurationSeconds="10">
      <Stimulus ns:type="TextStimulus" Caption="+"/>
    </Task>
	  <Task ns:type="MultiTask" ID="MT_TaskSequence" TaskOrder="Deterministic" SampleSize="100">
		  <Task ns:type="MultiTask" ID="MT_Move" TaskOrder="RandomWithoutReplacement" SampleSize="1">
			  <Task ns:type="SingleTask" ID="ST_MoveThumb" DurationSeconds="1" Group="1">
          <Stimulus ns:type="PictureStimulus" FileName="moveThumb.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_MoveIndex" DurationSeconds="1" Group="2">
			    <Stimulus ns:type="PictureStimulus" FileName="moveIndex.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_MoveMiddle" DurationSeconds="1" Group="3">
			    <Stimulus ns:type="PictureStimulus" FileName="moveMiddle.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_MoveRing" DurationSeconds="1" Group="4">
			    <Stimulus ns:type="PictureStimulus" FileName="moveRing.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_MoveLittle" DurationSeconds="1" Group="5">
			    <Stimulus ns:type="PictureStimulus" FileName="moveLittle.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
		  </Task>
		  <Task ns:type="MultiTask" ID="MT_Distract" TaskOrder="RandomWithoutReplacement" SampleSize="1">
			  <Task ns:type="SingleTask" ID="ST_Distractor1" DurationSeconds="1.7" Group="6">
			    <Stimulus ns:type="PictureStimulus" FileName="moveThumb_scrambled.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_Distractor2" DurationSeconds="1.9" Group="6">
			    <Stimulus ns:type="PictureStimulus" FileName="moveIndex_scrambled.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_Distractor3" DurationSeconds="2.1" Group="6">
			    <Stimulus ns:type="PictureStimulus" FileName="moveMiddle_scrambled.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_Distractor4" DurationSeconds="2.3" Group="6">
			    <Stimulus ns:type="PictureStimulus" FileName="moveRing_scrambled.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_Distractor5" DurationSeconds="2.5" Group="6">
			    <Stimulus ns:type="PictureStimulus" FileName="moveLittle_scrambled.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
		  </Task>
	  </Task>
    <Task ns:type="SingleTask" ID="ST_PostParadigm" DurationSeconds="5">
      <Stimulus ns:type="TextStimulus" Caption="Thank You!"/>
    </Task>
  </Paradigm>

</Data>