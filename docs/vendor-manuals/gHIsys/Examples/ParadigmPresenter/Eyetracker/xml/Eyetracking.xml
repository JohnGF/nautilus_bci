<?xml version="1.0" encoding="utf-8"?>
<Data  xmlns="xsd"
           xmlns:ns="http://www.w3.org/2001/XMLSchema-instance"
           ns:schemaLocation="xsd ../../ParadigmSchema.xsd">

  <Paradigm BaseFolder="media/" TaskOrder="Deterministic">
    <Task ns:type="SingleTask" ID="ST_PreParadigm" DurationSeconds="10">
      <Stimulus ns:type="TextStimulus" Caption="+"/>
    </Task>
	  <Task ns:type="MultiTask" ID="MT_TaskSequence" TaskOrder="Deterministic" SampleSize="32">
		  <Task ns:type="MultiTask" ID="MT_Move" TaskOrder="RandomWithoutReplacement" SampleSize="1">
			  <Task ns:type="SingleTask" ID="ST_REST1" DurationSeconds="2.75" Group="5">
				<Stimulus ns:type="TextStimulus" Caption="+"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_REST2" DurationSeconds="2.875" Group="5">
				<Stimulus ns:type="TextStimulus" Caption="+"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_REST3" DurationSeconds="3" Group="5">
				<Stimulus ns:type="TextStimulus" Caption="+"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_REST4" DurationSeconds="3.125" Group="5">
				<Stimulus ns:type="TextStimulus" Caption="+"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_REST5" DurationSeconds="3.25" Group="5">
				<Stimulus ns:type="TextStimulus" Caption="+"/>
			  </Task>
		  </Task>
		  <Task ns:type="MultiTask" ID="MT_Distract" TaskOrder="RandomWithoutReplacement" SampleSize="1">
			  <Task ns:type="SingleTask" ID="ST_TL" DurationSeconds="3" Group="1">
			    <Stimulus ns:type="PictureStimulus" FileName="TL.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_TR" DurationSeconds="3" Group="2">
			    <Stimulus ns:type="PictureStimulus" FileName="TR.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_BL" DurationSeconds="3" Group="3">
			    <Stimulus ns:type="PictureStimulus" FileName="BL.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
			  <Task ns:type="SingleTask" ID="ST_BR" DurationSeconds="3" Group="4">
			    <Stimulus ns:type="PictureStimulus" FileName="BR.png" HorizontalAlignment="Center" VerticalAlignment="Center" Scaling="Manual" ManualScalingPercent="100"/>
			  </Task>
		  </Task>
	  </Task>
    <Task ns:type="SingleTask" ID="ST_PostParadigm" DurationSeconds="50"  Group="6">
      <Stimulus ns:type="TextStimulus" Caption="Thank You!"/>
    </Task>
  </Paradigm>

</Data>