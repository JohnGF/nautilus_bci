<?xml version="1.0" encoding="utf-8"?>
<Data xmlns="xsd" xmlns:ns="http://www.w3.org/2001/XMLSchema-instance" ns:schemaLocation="xsd ../ParadigmSchema.xsd">
  <Paradigm BaseFolder="media/" TaskOrder="Deterministic" UdpAddress="127.0.0.1" UdpPort="1000">
    <Task ns:type="SingleTask" ID="ST_PreParadigm" DurationSeconds="10">
      <Stimulus ns:type="TextStimulus" Caption="+" />
    </Task>
    <Task ns:type="MultiTask" ID="MT_Sequence" TaskOrder="RandomWithoutReplacement" SampleSize="90">
      <Task ns:type="MultiTask" ID="MT_Target" TaskOrder="Deterministic" SampleSize="2">
        <Task ns:type="SingleTask" ID="ST_Target" DurationSeconds="0.25" Group="1">
          <Stimulus ns:type="AudioStimulus" FileName="Target.wav" UdpMessage="gR(1)"/>
        </Task>
        <Task ns:type="SingleTask" ID="ST_TargetSpacer" DurationSeconds="0.25" Group="0"/>
      </Task>
      <Task ns:type="MultiTask" ID="MT_NonTarget" TaskOrder="Deterministic" SampleSize="2" Multiplicity="8">
        <Task ns:type="SingleTask" ID="ST_NonTarget" DurationSeconds="0.25" Group="2">
          <Stimulus ns:type="AudioStimulus" FileName="Nontarget.wav" UdpMessage="gR(2)"/>
        </Task>
        <Task ns:type="SingleTask" ID="ST_NonTargetSpacer" DurationSeconds="0.25" Group="0"/>
      </Task>
    </Task>
    <Task ns:type="SingleTask" ID="ST_PostParadigm" DurationSeconds="5">
      <Stimulus ns:type="TextStimulus" Caption="Thank You!" />
    </Task>
  </Paradigm>
</Data>
